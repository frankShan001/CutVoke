# These are exact upstream notice bytes with pinned SHA256 provenance.
# Windows checkouts must not convert their line endings.
desktop/licenses/* -text
# Generated brand checksums include these exact UTF-8/LF bytes on every platform.
docs/assets/brand/*.json text eol=lf
docs/assets/readme/banner.svg text eol=lf
# Approved resource hashes cover the original bytes, including CRLF sidecars.
# Preserve those bytes on every OS; never rewrite an approval to hide a mismatch.
src/cutvoke/assets/**/*.json -text
src/cutvoke/core/builtin_presets.json -text
src/cutvoke/core/builtin_stickers.json -text
src/cutvoke/assets/fonts/OFL-*.txt -text -whitespace

# Versioned showcase packages and finished videos are deliberate project assets.
examples/showcases/chase-the-light/*.mp4 filter=lfs diff=lfs merge=lfs -text
examples/showcases/chase-the-light/*.cvkpkg filter=lfs diff=lfs merge=lfs -text
examples/showcases/chase-the-light/*.zip filter=lfs diff=lfs merge=lfs -text

# Bilingual examples include editable archives and their original media.
examples/showcases/**/*.mp4 filter=lfs diff=lfs merge=lfs -text
examples/showcases/**/*.mov filter=lfs diff=lfs merge=lfs -text
examples/showcases/**/*.wav filter=lfs diff=lfs merge=lfs -text
examples/showcases/**/*.cutvokepack filter=lfs diff=lfs merge=lfs -text
examples/showcases/**/source-media/*.png filter=lfs diff=lfs merge=lfs -text
# The bilingual manifests hash these indexes byte for byte.
examples/showcases/**/source-media/*.json -text
