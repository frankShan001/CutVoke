recursive-include .artifacts/web *
include README.zh-CN.md CONTRIBUTING.md CONTRIBUTING.zh-CN.md SECURITY.md CHANGELOG.md
include docs/*.md
recursive-include docs/user *.md *.json
recursive-include docs/development *.md *.json
recursive-include docs/research *.md *.json
recursive-include docs/images *.md *.json *.png *.svg
prune docs/history
prune private
prune local-notes
recursive-include resources *.md *.json *.png
recursive-include skills *.md *.py
recursive-include effects *.md *.json *.png LICENSE
recursive-include examples *.md *.py *.json
recursive-include tools *.py *.mjs *.cmd *.ps1 *.sh *.md
recursive-include tests *.py *.md
recursive-include apps/editor *.json *.ts *.tsx *.css *.html *.mjs
recursive-include apps/editor/public *
prune apps/editor/node_modules
prune apps/editor/test-results
prune apps/editor/playwright-report
include apps/desktop/*.cjs apps/desktop/*.js apps/desktop/*.html apps/desktop/*.spec apps/desktop/*.py apps/desktop/*.json
recursive-include apps/desktop/locales *.json
recursive-include apps/desktop/assets *.png *.ico *.icns
recursive-include apps/desktop/licenses *
include apps/desktop/*.lock
include apps/desktop/*.txt
include .github/workflows/*.yml .github/ISSUE_TEMPLATE/*.yml .github/PULL_REQUEST_TEMPLATE.md
include start-cutvoke.cmd
include .gitattributes .gitignore uv.lock
global-exclude *.py[cod]
global-exclude __pycache__
