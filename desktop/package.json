{
  "name": "cutvoke-desktop",
  "version": "0.3.1",
  "private": true,
  "description": "CutVoke local video editor",
  "author": "frankShan001",
  "license": "MIT",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --config.directories.output=../.artifacts/desktop && node publish-build.cjs",
    "unpacked": "electron-builder --win --x64 --dir --config.directories.output=../.artifacts/desktop",
    "portable": "electron-builder --config portable-builder.cjs --win --x64 --dir --config.directories.output=../.artifacts/desktop",
    "test:storage": "node --test storage.test.cjs",
    "test:settings": "node --test settings.test.cjs",
    "test:settings:electron": "node --test settings.electron.test.cjs",
    "test:build-deps": "node --test build-dependencies.test.cjs",
    "test:i18n": "node --test i18n.test.cjs",
    "test:i18n:electron": "node --test i18n.electron.test.cjs",
    "package:unix": "electron-builder --config unix-builder.cjs --dir --config.directories.output=../.artifacts/desktop"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.cutvoke.editor",
    "productName": "CutVoke",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "../dist/desktop"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "i18n.cjs",
      "storage.cjs",
      "settings.cjs",
      "locales/*.json",
      "loading.html",
      "loading.js",
      "assets/brand/icon-256.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../.artifacts/build/desktop-engine/cutvoke-engine",
        "to": "engine"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/brand/cutvoke.ico",
      "signExecutable": false,
      "artifactName": "CutVoke-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "installerIcon": "assets/brand/cutvoke.ico",
      "uninstallerIcon": "assets/brand/cutvoke.ico",
      "installerHeaderIcon": "assets/brand/cutvoke.ico",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "overrides": {
    "@electron/get@^3.0.0": {
      "global-agent": "4.1.3"
    }
  }
}
